{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision",
  "type": "object",
  "required": ["id", "ref", "board_id", "number", "title", "statement", "decided_by", "decided_on", "recorded_by", "recorded_by_handle", "status", "tags", "source_message_id", "version", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string" },
    "ref": { "type": "string", "pattern": "^D-[0-9]+$" },
    "board_id": { "type": "string" },
    "number": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "statement": { "type": "string" },
    "rationale": { "type": ["string", "null"] },
    "decided_by": { "type": "string" },
    "decided_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "recorded_by": { "type": "string" },
    "recorded_by_handle": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "superseded", "revoked"] },
    "superseded_by": { "type": ["string", "null"] },
    "superseded_by_ref": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "source_message_id": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": true
}
