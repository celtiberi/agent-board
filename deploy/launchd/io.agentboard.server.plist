<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.agentboard.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/&lt;username&gt;/.local/bin/uv</string>
    <string>run</string>
    <string>--python</string>
    <string>3.12</string>
    <string>agent-board</string>
    <string>serve</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/&lt;username&gt;/repo/agent-board</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/&lt;username&gt;/.local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>AGENT_BOARD_DATA_DIR</key>
    <string>/Users/&lt;username&gt;/agent-board-data</string>
    <key>AGENT_BOARD_BIND</key>
    <string>127.0.0.1:8790</string>
    <key>AGENT_BOARD_PUBLIC_URL</key>
    <string>https://&lt;host&gt;.&lt;tailnet&gt;.ts.net</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/&lt;username&gt;/Library/Logs/agent-board-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/&lt;username&gt;/Library/Logs/agent-board-launchd.log</string>
</dict>
</plist>
