[Unit]
Description=Agent Board (MCP + REST + Web UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agentboard
WorkingDirectory=/opt/agent-board
Environment=AGENT_BOARD_DATA_DIR=/var/lib/agent-board
Environment=AGENT_BOARD_BIND=127.0.0.1:8790
ExecStart=/usr/local/bin/uv run --python 3.12 agent-board serve
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
